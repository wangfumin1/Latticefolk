{
  "name": "latticefolk",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D web sandbox for autonomous NPC towns with pluggable decision engines.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets:prepare": "node scripts/prepare-scene-assets.mjs",
    "predev": "npm run assets:prepare",
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "predev:web": "npm run assets:prepare",
    "dev:web": "vite",
    "prebuild": "npm run assets:prepare",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test:e2e": "playwright test",
    "validate:local": "node scripts/validate-local.mjs"
  },
  "keywords": [
    "autonomous-agents",
    "npc",
    "simulation",
    "threejs",
    "webgl",
    "game-ai",
    "decision-model"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "three": "^0.180.0",
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "@types/better-sqlite3": "^7.6.13",
    "@playwright/test": "^1.63.0",
    "jsdom": "27.0.0"
  }
}
