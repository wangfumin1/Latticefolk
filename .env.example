# Decision provider: auto | fallback | jev
# auto = use Jev when a server-side key is present, otherwise use the local deterministic provider.
DECISION_PROVIDER=auto

# Optional TypeSafe Jev provider. Keep credentials server-side only.
TYPESAFE_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=2500
JEV_MAX_CALLS_PER_MINUTE=60
JEV_BUDGET_ENABLED=true
JEV_MAX_INPUT_TOKENS_PER_MINUTE=120000
JEV_MAX_INPUT_TOKENS_PER_HOUR=1000000
JEV_MAX_INPUT_TOKENS_PER_DAY=5000000
JEV_MAX_USD_PER_DAY=0.25
JEV_MIN_CONFIDENCE=0.35
JEV_CACHE_TTL_MS=2500
JEV_NPC_WEIGHT=1
JEV_DIALOGUE_WEIGHT=1
JEV_CHUNK_WEIGHT=0.65
JEV_REGION_WEIGHT=0.5
JEV_WORLD_WEIGHT=0.35

# Runtime budget editing is enabled automatically in development.
# For a production deployment, opt in explicitly before exposing God-mode admin controls.
ALLOW_RUNTIME_ADMIN=false

# HTTP server
PORT=8787
