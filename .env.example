# Decision provider: auto | fallback | jev
# auto = use Jev when a server-side key is present, otherwise use the local deterministic provider.
DECISION_PROVIDER=auto

# Optional TypeSafe Jev provider. Keep credentials server-side only.
TYPESAFE_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=2500
JEV_MAX_CALLS_PER_MINUTE=60

# HTTP server
PORT=8787
